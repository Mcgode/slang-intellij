<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>slang.plugin</id>
    <name>Slang Language Support</name>
    <vendor email="maxgodefroy@gmail.com" url="https://github.com/Mcgode/slang-intellij">Max Godefroy</vendor>

    <depends>com.intellij.modules.platform</depends>

    <!-- LSP client API. Optional so the plugin still loads on IDEs/builds without LSP support
         (IntelliJ IDEA open-source builds, Android Studio as of 2026.2); LSP features are simply
         inactive there. -->
    <depends optional="true" config-file="slang-lsp.xml">com.intellij.modules.lsp</depends>

    <!-- Bundled everywhere in practice, but optional so a stripped IDE without it still loads. -->
    <depends optional="true" config-file="slang-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <resource-bundle>messages.SlangBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Slang"
            language="Slang"
            implementationClass="slang.plugin.language.SlangFileType"
            fieldName="INSTANCE"
            extensions="slang;slangh" />

        <!-- GLSL and HLSL, handled through slangd (see GlslLanguage / HlslLanguage). Extensions are
             associated at runtime from the settings, not declared here, to avoid clashing with the
             standalone GLSL plugin and with Rider's built-in HLSL support. -->
        <fileType
            name="GLSL"
            language="GLSL"
            implementationClass="slang.plugin.language.GlslFileType"
            fieldName="INSTANCE" />
        <fileType
            name="HLSL"
            language="HLSL"
            implementationClass="slang.plugin.language.HlslFileType"
            fieldName="INSTANCE" />

        <lang.parserDefinition
            language="Slang"
            implementationClass="slang.plugin.lang.SlangParserDefinition" />
        <lang.parserDefinition
            language="GLSL"
            implementationClass="slang.plugin.lang.GlslParserDefinition" />
        <lang.parserDefinition
            language="HLSL"
            implementationClass="slang.plugin.lang.HlslParserDefinition" />

        <lang.syntaxHighlighterFactory
            language="Slang"
            implementationClass="slang.plugin.highlight.SlangSyntaxHighlighterFactory" />
        <lang.syntaxHighlighterFactory
            language="GLSL"
            implementationClass="slang.plugin.highlight.SlangSyntaxHighlighterFactory" />
        <lang.syntaxHighlighterFactory
            language="HLSL"
            implementationClass="slang.plugin.highlight.SlangSyntaxHighlighterFactory" />

        <colorSettingsPage implementation="slang.plugin.highlight.SlangColorSettingsPage" />

        <lang.commenter
            language="Slang"
            implementationClass="slang.plugin.editor.SlangCommenter" />
        <lang.commenter
            language="GLSL"
            implementationClass="slang.plugin.editor.SlangCommenter" />
        <lang.commenter
            language="HLSL"
            implementationClass="slang.plugin.editor.SlangCommenter" />

        <lang.braceMatcher
            language="Slang"
            implementationClass="slang.plugin.editor.SlangBraceMatcher" />
        <lang.braceMatcher
            language="GLSL"
            implementationClass="slang.plugin.editor.SlangBraceMatcher" />
        <lang.braceMatcher
            language="HLSL"
            implementationClass="slang.plugin.editor.SlangBraceMatcher" />

        <lang.quoteHandler
            language="Slang"
            implementationClass="slang.plugin.editor.SlangQuoteHandler" />
        <lang.quoteHandler
            language="GLSL"
            implementationClass="slang.plugin.editor.SlangQuoteHandler" />
        <lang.quoteHandler
            language="HLSL"
            implementationClass="slang.plugin.editor.SlangQuoteHandler" />

        <lang.foldingBuilder
            language="Slang"
            implementationClass="slang.plugin.editor.SlangFoldingBuilder" />
        <lang.foldingBuilder
            language="GLSL"
            implementationClass="slang.plugin.editor.SlangFoldingBuilder" />
        <lang.foldingBuilder
            language="HLSL"
            implementationClass="slang.plugin.editor.SlangFoldingBuilder" />

        <lineIndentProvider implementation="slang.plugin.editor.SlangLineIndentProvider" />

        <indexPatternBuilder implementation="slang.plugin.editor.SlangIndexPatternBuilder" />

        <postStartupActivity implementation="slang.plugin.language.ShaderFileTypeStartup" />

        <highlightUsagesHandlerFactory
            implementation="slang.plugin.editor.SlangOccurrencesHighlightingFactory" />

        <notificationGroup id="Slang" displayType="BALLOON" />

        <projectConfigurable
            parentId="language"
            id="slang.plugin.settings.SlangSettingsConfigurable"
            instance="slang.plugin.settings.SlangSettingsConfigurable"
            displayName="Slang" />

        <applicationService serviceImplementation="slang.plugin.settings.SlangSettings" />
        <projectService serviceImplementation="slang.plugin.settings.SlangProjectSettings" />
    </extensions>
</idea-plugin>
