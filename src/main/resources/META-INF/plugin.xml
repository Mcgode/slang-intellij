<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>slang.plugin</id>
    <name>Slang Language Support</name>
    <vendor email="maxgodefroy@gmail.com" url="https://github.com/Mcgode/slang-intellij">Max Godefroy</vendor>

    <depends>com.intellij.modules.platform</depends>

    <!-- LSP client API. Optional so the plugin still loads on IDEs/builds without LSP support
         (IntelliJ IDEA open-source builds, Android Studio as of 2026.2); LSP features are simply
         inactive there. -->
    <depends optional="true" config-file="slang-lsp.xml">com.intellij.modules.lsp</depends>

    <resource-bundle>messages.SlangBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Slang"
            language="Slang"
            implementationClass="slang.plugin.language.SlangFileType"
            fieldName="INSTANCE"
            extensions="slang;slangh" />

        <lang.parserDefinition
            language="Slang"
            implementationClass="slang.plugin.lang.SlangParserDefinition" />

        <lang.syntaxHighlighterFactory
            language="Slang"
            implementationClass="slang.plugin.highlight.SlangSyntaxHighlighterFactory" />

        <colorSettingsPage implementation="slang.plugin.highlight.SlangColorSettingsPage" />

        <lang.commenter
            language="Slang"
            implementationClass="slang.plugin.editor.SlangCommenter" />

        <lang.braceMatcher
            language="Slang"
            implementationClass="slang.plugin.editor.SlangBraceMatcher" />

        <lang.foldingBuilder
            language="Slang"
            implementationClass="slang.plugin.editor.SlangFoldingBuilder" />

        <notificationGroup id="Slang" displayType="BALLOON" />

        <applicationConfigurable
            parentId="language"
            id="slang.plugin.settings.SlangSettingsConfigurable"
            instance="slang.plugin.settings.SlangSettingsConfigurable"
            displayName="Slang" />

        <applicationService serviceImplementation="slang.plugin.settings.SlangSettings" />
    </extensions>
</idea-plugin>
